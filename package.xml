<?xml version="1.0"?>
<package format="3">
  <name>stretch4_mission</name>
  <version>0.4.0</version>
  <description>Multi-step Stretch 4 missions: policy, navigate-only and command steps. Nav2 to each step goal with lidar alignment, then a learned policy through stretch4_policy_recorder or LeRobot async inference. Web UI with map, global localization, mission editor and live state machine.</description>
  <maintainer email="jlurquieta1@gmail.com">Jose Luis Urquieta Aguilar</maintainer>
  <author email="jlurquieta1@gmail.com">Jose Luis Urquieta Aguilar</author>
  <author>Samuel Francisco Cabrera Ramirez</author>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>hello_helpers</exec_depend>
  <exec_depend>stretch_nav2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
